{
  "schemaVersion": 2,
  "rules": [],
  "facts": [
    { "id": "pattern.produce" },
    { "id": "pattern.buy.upgrade" },
    { "id": "pattern.merge" },
    { "id": "pattern.prestige" },
    { "id": "pattern.prestige.settled" },
    { "id": "pattern.workers.worked" },
    { "id": "pattern.status.apply" },
    { "id": "pattern.unlock" }
  ],
  "fragments": [
    {
      "id": "pattern.producer",
      "schedules": [
        {
          "id": "pattern.producer.pulse", "event": "pattern.produce", "everyTicks": 60,
          "sourceEntityId": "pattern.drill", "targetEntityId": "pattern.ore"
        }
      ],
      "rules": [
        {
          "id": "produces", "on": "pattern.produce", "priority": 10,
          "when": [
            { "kind": "hasTag", "subject": "source", "tag": "pattern.producer" },
            { "kind": "hasTag", "subject": "target", "tag": "pattern.resource" }
          ],
          "effects": [
            { "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 1 },
            { "kind": "adjustProperty", "subject": "source", "property": "produced", "amount": 1 }
          ]
        },
        {
          "id": "ranked-rate", "on": "pattern.produce", "priority": 5,
          "when": [
            { "kind": "hasTag", "subject": "source", "tag": "pattern.producer" },
            { "kind": "expression", "expression": "source.rate >= 2" }
          ],
          "effects": [{ "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 1 }]
        }
      ]
    },
    {
      "id": "pattern.upgrade",
      "rules": [
        {
          "id": "buys", "on": "pattern.buy.upgrade", "priority": 10,
          "when": [
            { "kind": "hasTag", "subject": "source", "tag": "pattern.currency" },
            { "kind": "hasTag", "subject": "target", "tag": "pattern.producer" },
            { "kind": "propertyAtLeast", "subject": "source", "property": "balance", "value": 5 }
          ],
          "effects": [
            { "kind": "adjustProperty", "subject": "source", "property": "balance", "amount": -5 },
            { "kind": "adjustProperty", "subject": "target", "property": "rank", "amount": 1 },
            {
              "kind": "setModifier", "subject": "target", "property": "rate", "operation": "add",
              "value": 1, "fromProperty": "rank"
            }
          ]
        }
      ]
    },
    {
      "id": "pattern.talent",
      "bundles": [
        { "id": "pattern.talent.echo", "enabledByTag": "pattern.talent.echo" }
      ],
      "rules": [
        {
          "id": "echo.boost", "on": "pattern.produce", "bundle": "pattern.talent.echo",
          "priority": 20,
          "effects": [{ "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 2 }]
        }
      ]
    },
    {
      "id": "pattern.merge",
      "rules": [
        {
          "id": "tier-one", "on": "pattern.merge", "priority": 10,
          "when": [
            { "kind": "hasTag", "subject": "source", "tag": "pattern.mergeable" },
            { "kind": "hasTag", "subject": "target", "tag": "pattern.mergeable" },
            { "kind": "expression", "expression": "source.id != target.id" },
            { "kind": "expression", "expression": "source.tier == target.tier" },
            { "kind": "expression", "expression": "source.tier == 1" }
          ],
          "effects": [
            { "kind": "spawn", "subject": "target", "template": "pattern.fruit.high" },
            { "kind": "despawn", "subject": "source" },
            { "kind": "despawn", "subject": "target" }
          ]
        },
        {
          "id": "tier-two", "on": "pattern.merge", "priority": 10,
          "when": [
            { "kind": "hasTag", "subject": "source", "tag": "pattern.mergeable" },
            { "kind": "hasTag", "subject": "target", "tag": "pattern.mergeable" },
            { "kind": "expression", "expression": "source.id != target.id" },
            { "kind": "expression", "expression": "source.tier == target.tier" },
            { "kind": "expression", "expression": "source.tier == 2" }
          ],
          "effects": [
            { "kind": "spawn", "subject": "target", "template": "pattern.fruit.top" },
            { "kind": "despawn", "subject": "source" },
            { "kind": "despawn", "subject": "target" }
          ]
        }
      ]
    },
    {
      "id": "pattern.prestige",
      "rules": [
        {
          "id": "grants", "on": "pattern.prestige", "priority": 20,
          "when": [
            { "kind": "hasTag", "subject": "source", "tag": "scope.run" },
            { "kind": "hasTag", "subject": "target", "tag": "scope.meta" },
            { "kind": "propertyAtLeast", "subject": "source", "property": "earned", "value": 10 }
          ],
          "effects": [
            {
              "kind": "transfer", "subject": "source", "property": "earned",
              "targetProperty": "shards", "basisPoints": 1000
            },
            { "kind": "adjustProperty", "subject": "target", "property": "prestiges", "amount": 1 },
            { "kind": "emitEvent", "event": "pattern.prestige.settled" }
          ]
        },
        {
          "id": "clears", "on": "pattern.prestige.settled", "priority": 10,
          "effects": [{ "kind": "clearScope", "tag": "scope.run" }]
        }
      ]
    },
    {
      "id": "pattern.worker",
      "rules": [
        {
          "id": "paid", "on": "pattern.workers.worked", "priority": 10,
          "when": [
            { "kind": "hasTag", "factRow": "sample.pattern-pack.worker", "tag": "pattern.worker" },
            { "kind": "expression", "expression": "event.amount >= 1" }
          ],
          "effects": [
            {
              "kind": "adjustProperty", "factRow": "sample.pattern-pack.worker",
              "property": "mined", "amount": 1
            }
          ]
        }
      ]
    },
    {
      "id": "pattern.status",
      "rules": [
        {
          "id": "haste", "on": "pattern.status.apply", "priority": 10,
          "effects": [
            {
              "kind": "setModifier", "subject": "target", "property": "rate", "operation": "multiply",
              "value": 2, "durationTicks": 60
            }
          ]
        }
      ]
    },
    {
      "id": "pattern.unlock",
      "rules": [
        {
          "id": "opens", "on": "pattern.unlock", "priority": 10,
          "effects": [{ "kind": "addTag", "subject": "target", "tag": "pattern.unlocked" }]
        },
        {
          "id": "produces", "on": "pattern.produce", "priority": 30,
          "when": [{ "kind": "hasTag", "subject": "source", "tag": "pattern.unlocked" }],
          "effects": [{ "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 1 }]
        }
      ]
    }
  ],
  "useFragments": [
    "pattern.producer",
    "pattern.upgrade",
    "pattern.talent",
    "pattern.merge",
    "pattern.prestige",
    "pattern.worker",
    "pattern.status",
    "pattern.unlock"
  ]
}
