{
  "schemaVersion": 2,
  "rules": [],
  "schedules": [
    {
      "id": "pattern.producer.pulse",
      "event": "pattern.produce",
      "everyTicks": 60,
      "sourceEntityId": "pattern.drill",
      "targetEntityId": "pattern.ore"
    }
  ],
  "bundles": [
    { "id": "pattern.talent.echo", "enabledByTag": "pattern.talent.echo" }
  ],
  "fragments": [
    {
      "id": "pattern.producer",
      "rules": [
        {
          "id": "pattern.producer.produces", "on": "pattern.produce", "priority": 10,
          "when": [
            { "kind": "hasTag", "subject": "source", "tag": "pattern.producer" },
            { "kind": "hasTag", "subject": "target", "tag": "pattern.resource" }
          ],
          "effects": [
            { "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 1 },
            { "kind": "adjustProperty", "subject": "source", "property": "produced", "amount": 1 }
          ]
        },
        {
          "id": "pattern.producer.ranked-rate", "on": "pattern.produce", "priority": 5,
          "when": [
            { "kind": "hasTag", "subject": "source", "tag": "pattern.producer" },
            { "kind": "expression", "expression": "source.rate >= 2" }
          ],
          "effects": [{ "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 1 }]
        }
      ]
    },
    {
      "id": "pattern.upgrade",
      "rules": [
        {
          "id": "pattern.upgrade.buys", "on": "pattern.buy.upgrade", "priority": 10,
          "when": [{ "kind": "propertyAtLeast", "subject": "source", "property": "balance", "value": 5 }],
          "effects": [
            { "kind": "adjustProperty", "subject": "source", "property": "balance", "amount": -5 },
            { "kind": "adjustProperty", "subject": "target", "property": "rank", "amount": 1 },
            {
              "kind": "setModifier", "subject": "target", "property": "rate", "operation": "add",
              "value": 1, "fromProperty": "rank"
            }
          ]
        }
      ]
    },
    {
      "id": "pattern.talent",
      "rules": [
        {
          "id": "pattern.talent.echo.boost", "on": "pattern.produce", "bundle": "pattern.talent.echo",
          "priority": 20,
          "effects": [{ "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 2 }]
        }
      ]
    },
    {
      "id": "pattern.merge",
      "rules": [
        {
          "id": "pattern.merge.combines", "on": "pattern.merge", "priority": 10,
          "when": [
            { "kind": "hasTag", "subject": "source", "tag": "pattern.mergeable" },
            { "kind": "hasTag", "subject": "target", "tag": "pattern.mergeable" }
          ],
          "effects": [
            { "kind": "spawn", "subject": "target", "template": "pattern.fruit.high" },
            { "kind": "despawn", "subject": "source" },
            { "kind": "despawn", "subject": "target" }
          ]
        }
      ]
    },
    {
      "id": "pattern.prestige",
      "rules": [
        {
          "id": "pattern.prestige.grants", "on": "pattern.prestige", "priority": 20,
          "effects": [
            { "kind": "transfer", "subject": "source", "property": "earned", "amount": 10, "targetProperty": "shards" },
            { "kind": "adjustProperty", "subject": "target", "property": "prestiges", "amount": 1 },
            { "kind": "emitEvent", "event": "pattern.prestige.settled" }
          ]
        },
        {
          "id": "pattern.prestige.clears", "on": "pattern.prestige.settled", "priority": 10,
          "effects": [{ "kind": "clearScope", "tag": "scope.run" }]
        }
      ]
    },
    {
      "id": "pattern.worker",
      "rules": [
        {
          "id": "pattern.worker.paid", "on": "pattern.workers.worked", "priority": 10,
          "effects": [{ "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 1 }]
        }
      ]
    },
    {
      "id": "pattern.status",
      "rules": [
        {
          "id": "pattern.status.haste", "on": "pattern.status.apply", "priority": 10,
          "effects": [
            {
              "kind": "setModifier", "subject": "target", "property": "rate", "operation": "multiply",
              "value": 2, "durationTicks": 60
            }
          ]
        }
      ]
    },
    {
      "id": "pattern.unlock",
      "rules": [
        {
          "id": "pattern.unlock.opens", "on": "pattern.unlock", "priority": 10,
          "effects": [{ "kind": "addTag", "subject": "target", "tag": "pattern.unlocked" }]
        },
        {
          "id": "pattern.unlock.produces", "on": "pattern.produce", "priority": 30,
          "when": [{ "kind": "hasTag", "subject": "source", "tag": "pattern.unlocked" }],
          "effects": [{ "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 1 }]
        }
      ]
    },
    {
      "id": "pattern.offline",
      "rules": [
        {
          "id": "pattern.offline.catch-up", "on": "pattern.offline.catchup", "priority": 10,
          "effects": [{ "kind": "adjustProperty", "subject": "target", "property": "balance", "amount": 60 }]
        }
      ]
    }
  ],
  "useFragments": [
    "pattern.producer",
    "pattern.upgrade",
    "pattern.talent",
    "pattern.merge",
    "pattern.prestige",
    "pattern.worker",
    "pattern.status",
    "pattern.unlock",
    "pattern.offline"
  ]
}
