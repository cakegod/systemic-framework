  "fragments": [
    {
      "id": "talents.selection",
      "rules": [
        {
          "id": "selects", "on": "talent.select", "priority": 100,
          "when": [
            { "kind": "hasTag", "subject": "target", "tag": "ui.choice" },
            { "kind": "expression", "expression": "target.selected == 0 && target.free == 0" },
            { "kind": "propertyAtLeast", "subject": "source", "property": "talentPoints", "value": 1 },
            { "kind": "expression", "expression": "source.talentEarned >= target.unlock" }
          ],
          "effects": [
            { "kind": "adjustProperty", "subject": "source", "property": "talentPoints", "amount": -1 },
            { "kind": "adjustProperty", "subject": "source", "property": "talentSpent", "amount": 1 },
            { "kind": "adjustProperty", "subject": "target", "property": "selected", "amount": 1 }
          ]
        },
        {
          "id": "activates-free", "on": "talent.refresh", "priority": 100,
          "when": [
            { "kind": "hasTag", "subject": "target", "tag": "ui.choice" },
            { "kind": "propertyAtLeast", "subject": "target", "property": "free", "value": 1 },
            { "kind": "expression", "expression": "target.selected == 0" },
            { "kind": "expression", "expression": "source.talentEarned >= target.unlock" }
          ],
          "effects": [
            { "kind": "adjustProperty", "subject": "target", "property": "selected", "amount": 1 }
          ]
        }
      ]
    },
    {
      "id": "talents.default",
      "rules": [
        {
          "id": "motivation", "on": "talent.tick", "priority": 20,
          "when": [
            { "kind": "hasTag", "subject": "target", "tag": "talent.default.motivation" },
            { "kind": "propertyAtLeast", "subject": "target", "property": "selected", "value": 1 },
            { "kind": "expression", "expression": "source.runnerProgress >= 0.5" }
          ],
          "effects": [
            { "kind": "setModifier", "subject": "source", "property": "damage", "operation": "multiply", "value": 2, "durationTicks": 3 },
            { "kind": "setModifier", "subject": "source", "property": "comboChance", "operation": "add", "value": 0.05, "durationTicks": 3 },
            { "kind": "setModifier", "subject": "source", "property": "meditation", "operation": "set", "value": 1, "durationTicks": 3 }
          ]
        },
        {
          "id": "hiking-buddy", "on": "talent.depart", "priority": 20, "cooldownTicks": 600,
          "when": [
            { "kind": "hasTag", "subject": "target", "tag": "talent.default.hiking-buddy" },
            { "kind": "propertyAtLeast", "subject": "target", "property": "selected", "value": 1 }
          ],
          "effects": [
            { "kind": "spawn", "subject": "source", "template": "actor.hiking-friend" }
          ]
        },
        {
          "id": "runner-backstop", "on": "talent.tick", "priority": 20,
          "when": [
            { "kind": "hasTag", "subject": "target", "tag": "talent.default.runner-backstop" },
            { "kind": "propertyAtLeast", "subject": "target", "property": "selected", "value": 1 },
            { "kind": "expression", "expression": "source.collectionPerMinute < source.damage * 0.5" }
          ],
          "effects": [
            { "kind": "setModifier", "subject": "source", "property": "capacity", "operation": "add", "value": 20, "durationTicks": 3 }
          ]
        },
        {
          "id": "extra-housing", "on": "talent.build", "priority": 20,
          "when": [
            { "kind": "hasTag", "subject": "target", "tag": "talent.default.extra-housing" },
            { "kind": "propertyAtLeast", "subject": "target", "property": "selected", "value": 1 },
            { "kind": "expression", "expression": "source.buildCount > 0 && source.buildCount % 7 == 0" }
          ],
          "effects": [
            { "kind": "adjustProperty", "subject": "source", "property": "housing", "amount": 1 },
            { "kind": "adjustProperty", "subject": "source", "property": "buildCount", "amount": 1 }
          ]
        },
        {
          "id": "bathe-in-fire", "on": "talent.bomb", "priority": 20,
          "when": [
            { "kind": "hasTag", "subject": "target", "tag": "talent.default.bathe-in-fire" },
            { "kind": "propertyAtLeast", "subject": "target", "property": "selected", "value": 1 },
            { "kind": "expression", "expression": "source.heat >= 1" }
          ],
          "effects": [
            { "kind": "setModifier", "subject": "source", "property": "speed", "operation": "add", "value": 20, "durationTicks": 120 },
            { "kind": "adjustProperty", "subject": "source", "property": "launchDistance", "amount": 1 }
          ]
        }
      ]
    },
