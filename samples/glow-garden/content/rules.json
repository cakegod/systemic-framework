{
  "schemaVersion": 2,
  "schedules": [
    {
      "id": "garden.pulse",
      "event": "garden.tick",
      "everyTicks": 1,
      "sourceEntityId": "garden",
      "targetEntityId": "garden"
    }
  ],
  "rules": [
    {
      "id": "garden.talent.echo",
      "on": "garden.pod.burst",
      "priority": 0,
      "when": [
        {
          "kind": "hasTag",
          "subject": "source",
          "tag": "garden.talent.echo"
        }
      ],
      "effects": [
        {
          "kind": "adjustProperty",
          "subject": "source",
          "property": "garden.talent.echo.uses",
          "amount": 1
        },
        {
          "kind": "emitEvent",
          "event": "garden.talent.echo"
        }
      ]
    },
    {
