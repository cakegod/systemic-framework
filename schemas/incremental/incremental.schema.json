{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://press-the-button.dev/systemic/incremental.schema.json",
  "title": "Engine-neutral incremental systems",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resources", "producers", "upgrades", "roles"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "resources": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/resource" } },
    "producers": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/producer" } },
    "upgrades": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/upgrade" } },
    "roles": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/role" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "names": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entityId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entityId": { "$ref": "#/$defs/id" },
        "balanceProperty": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "initialValue": { "type": "number", "minimum": 0 },
        "capacity": { "type": "number", "minimum": 0 }
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entityId", "resourceId", "baseRate"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entityId": { "$ref": "#/$defs/id" },
        "resourceId": { "$ref": "#/$defs/id" },
        "rateProperty": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "baseRate": { "type": "number", "minimum": 0 },
        "intervalTicks": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "eventType": { "$ref": "#/$defs/id" }
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["resourceId", "amount"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/id" },
        "amount": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "upgrade": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entityId", "costs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "entityId": { "$ref": "#/$defs/id" },
        "costs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/cost" } },
        "maxPurchases": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "purchaseCountProperty": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "purchasedEvent": { "$ref": "#/$defs/id" }
      }
    },
    "role": {
      "type": "object", "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tags": { "$ref": "#/$defs/names" },
        "capabilities": { "$ref": "#/$defs/names" }
      }
    }
  }
}
