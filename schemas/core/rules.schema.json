{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://press-the-button.dev/systemic/rules.schema.json",
  "title": "Bounded systemic rule set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "rules": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/rule" } },
    "schedules": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/schedule" } },
    "facts": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/fact" } },
    "fragments": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/fragment" } },
    "useFragments": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "subject": { "enum": ["source", "target"] },
    "subjectForm": {
      "anyOf": [
        { "required": ["subject"] },
        { "required": ["row"] },
        { "required": ["factRow"] }
      ]
    },
    "rowSubject": {
      "type": "object", "additionalProperties": false,
      "required": ["population"],
      "properties": {
        "population": { "$ref": "#/$defs/id" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "event", "everyTicks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "event": { "$ref": "#/$defs/id" },
        "everyTicks": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "offsetTicks": { "type": "integer", "minimum": 0, "maximum": 999999 },
        "sourceEntityId": { "$ref": "#/$defs/id" },
        "targetEntityId": { "$ref": "#/$defs/id" },
        "amount": { "type": "number" },
        "payload": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/payloadValue" } }
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "payload": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/payloadField" } }
      }
    },
    "payloadField": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "kind"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
        "kind": { "enum": ["integer", "number", "text", "boolean"] }
      }
    },
    "payloadValue": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
        "value": { "anyOf": [{ "type": "integer" }, { "type": "number" }, { "type": "string" }, { "type": "boolean" }] }
      }
    },
    "fragment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rules"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rules": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/rule" } },
        "useFragments": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "on", "priority", "effects"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "on": { "$ref": "#/$defs/id" },
        "priority": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "when": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/condition" } },
        "effects": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["hasTag", "propertyAtLeast", "expression", "chance"] },
        "subject": { "$ref": "#/$defs/subject" },
        "row": { "$ref": "#/$defs/rowSubject" },
        "factRow": { "$ref": "#/$defs/id" },
        "tag": { "type": "string", "pattern": "\\S" },
        "property": { "type": "string", "pattern": "\\S" },
        "value": { "type": "number" },
        "expression": { "type": "string", "pattern": "\\S" },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "hasTag" } }, "required": ["kind"] }, "then": { "$ref": "#/$defs/subjectForm", "required": ["tag"] } },
        { "if": { "properties": { "kind": { "const": "propertyAtLeast" } }, "required": ["kind"] }, "then": { "$ref": "#/$defs/subjectForm", "required": ["property", "value"] } },
        { "if": { "properties": { "kind": { "const": "expression" } }, "required": ["kind"] }, "then": { "required": ["expression"] } },
        { "if": { "properties": { "kind": { "const": "chance" } }, "required": ["kind"] }, "then": { "required": ["probability"] } }
      ]
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["adjustProperty", "setModifier", "addTag", "emitEvent"] },
        "subject": { "$ref": "#/$defs/subject" },
        "row": { "$ref": "#/$defs/rowSubject" },
        "factRow": { "$ref": "#/$defs/id" },
        "property": { "type": "string", "pattern": "\\S" },
        "amount": { "type": "number" },
        "tag": { "type": "string", "pattern": "\\S" },
        "event": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["add", "multiply", "set"] },
        "value": { "type": "number" },
        "stage": { "enum": ["foundation", "standard", "additive", "multiplicative", "override", "final"] },
        "durationTicks": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "payload": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/payloadValue" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "adjustProperty" } }, "required": ["kind"] }, "then": { "$ref": "#/$defs/subjectForm", "required": ["property", "amount"] } },
        { "if": { "properties": { "kind": { "const": "setModifier" } }, "required": ["kind"] }, "then": { "$ref": "#/$defs/subjectForm", "required": ["property", "operation", "value"] } },
        { "if": { "properties": { "kind": { "const": "addTag" } }, "required": ["kind"] }, "then": { "$ref": "#/$defs/subjectForm", "required": ["tag"] } },
        { "if": { "properties": { "kind": { "const": "emitEvent" } }, "required": ["kind"] }, "then": { "required": ["event"] } }
      ]
    }
  }
}
