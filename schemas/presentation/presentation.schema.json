{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://press-the-button.dev/systemic/presentation.schema.json",
  "title": "Presentation timelines and fact cues",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "timelines", "bindings"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "timelines": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/timeline" } },
    "bindings": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/binding" } },
    "choiceIcons": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "visualRecipeId", "durationTicks", "loop", "keyframes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "visualRecipeId": { "$ref": "#/$defs/id" },
        "durationTicks": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "loop": { "type": "boolean" },
        "particleCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "keyframes": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/keyframe" } }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "x": { "type": "number", "minimum": -4096, "maximum": 4096 },
        "y": { "type": "number", "minimum": -4096, "maximum": 4096 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 64 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "visualState": { "$ref": "#/$defs/id" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "timelineId", "anchor"],
      "properties": {
        "event": { "$ref": "#/$defs/id" },
        "timelineId": { "$ref": "#/$defs/id" },
        "anchor": { "enum": ["source", "target", "midpoint"] },
        "seedSalt": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
      }
    }
  }
}
