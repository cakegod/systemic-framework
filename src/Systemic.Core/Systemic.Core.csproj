<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CorvusTextJsonOptionalAsNullable>NullOrUndefined</CorvusTextJsonOptionalAsNullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Corvus.Text.Json.Validator" Version="5.7.9" />
    <PackageReference Include="Corvus.Text.Json.SourceGenerator" Version="5.7.9" PrivateAssets="all" />
    <ProjectReference Include="../Systemic.Kernel/Systemic.Kernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="../../schemas/core/*.schema.json" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../schemas/core/*.schema.json"
                      LogicalName="Systemic.Core.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
