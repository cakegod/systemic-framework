<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0"
                      Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Systemic.Kernel/Systemic.Kernel.csproj" />
    <ProjectReference Include="../../Systemic.Core/Systemic.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../schemas/presentation/*.schema.json"
                      LogicalName="Systemic.Presentation.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
